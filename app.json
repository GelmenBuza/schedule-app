{
  "expo": {
    "name": "Расписание",
    "slug": "schedule-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/schedule.png",
    "scheme": "scheduleapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 1,
      "package": "ru.college.schedule",
      "adaptiveIcon": {
        "backgroundColor": "#316bff",
        "foregroundImage": "./assets/images/scheduleIco.png",
        "monochromeImage": "./assets/images/scheduleMono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#316bff",
          "image": "./assets/images/scheduleIco.png",
          "imageWidth": 76
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
